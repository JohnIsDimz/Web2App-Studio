# =============================================
# Web2App Studio - Backend Environment
# =============================================
# Copy file ini ke .env: cp .env.example .env
# File .env JANGAN di-commit ke Git (sudah di .gitignore)
# =============================================

# ===== Application =====
NODE_ENV=development
APP_NAME=Web2App Studio
APP_PORT=3000
APP_BASE_URL=http://localhost:3000
APP_FRONTEND_URL=http://localhost:5500

# ===== Supabase =====
# ⚠️  Kredensial ada di assets/js/auth.js (frontend) & assets/js/api.js
# ⚠️  JANGAN isi API key di file ini.
# Backend ambil dari env variable yang Anda set manual saat deploy.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ⚠️  DARI DASHBOARD: Settings → API → service_role secret
# JANGAN PERNAH expose ke frontend!
SUPABASE_SERVICE_ROLE_KEY=

# ⚠️  DARI DASHBOARD: Settings → API → JWT Secret
SUPABASE_JWT_SECRET=

# ===== Pakasir Payment Gateway =====
# https://app.pakasir.com → Project → API Key & Webhook Secret
PAKASIR_BASE_URL=https://app.pakasir.com/api
PAKASIR_API_KEY=GANTI_DARI_DASHBOARD_PAKASIR
PAKASIR_WEBHOOK_SECRET=GANTI_DARI_DASHBOARD_PAKASIR
PAKASIR_DEFAULT_METHOD=qris
PAKASIR_TIMEOUT_MS=15000

# ===== Redis (untuk Bull Queue) =====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===== Pricing (dalam IDR) =====
TOKEN_PRICE_IDR=500
PRICING_BASIC_IDR=15000
PRICING_PRO_IDR=30000
PRICING_PREMIUM_IDR=60000
TIER_BASIC_BUILD_QUOTA=35

# ===== Subscription Tiers =====
TIER_NONE=none
TIER_BASIC=basic
TIER_PRO=pro
TIER_PREMIUM=premium

# ===== Security =====
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===== Webhook Security =====
# Untuk development, set true untuk skip signature verification.
# ⚠️  JANGAN set true di production! Akan reject semua webhook kalau false tapi secret tidak di-set.
ALLOW_INSECURE_WEBHOOK=false

# ===== Session / Cookie Security =====
# Secret untuk sign session cookie. WAJIB di-set di production!
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Minimal 32 chars. Pakai random string yang SULIT ditebak.
COOKIE_SECRET=change-this-to-a-random-string-min-32-chars

# Session cookie options (sudah di-hardcode di server.js):
#   - httpOnly: true        (JS gak bisa baca cookie = anti-XSS token theft)
#   - secure: <auto>        (true di production = HTTPS only)
#   - sameSite: 'lax'       (CSRF protection)
#   - maxAge: 24 jam
#   - rolling: true         (reset expiry tiap request)

# ===== Pending Transaction Expiry =====
# Pending transaction yang gak dibayar dalam X menit otomatis di-mark 'expired' oleh cron.
# Default: 15 menit (sesuai QRIS Pakasir expiry)
PENDING_EXPIRY_MINUTES=15

# ===== Cron Jobs =====
# Secret untuk authenticate cron calls (x-cron-secret header)
# CRITICAL: ganti dengan random string min 32 chars di production!
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=change-this-to-a-random-string-min-32-chars

# Setup di VPS: crontab -e
#   setiap 5 menit   =>  expire-pending-transactions
#   setiap 30 menit  =>  reconcile-pending-payments
#   jam 01:00        =>  check-expired-subscriptions
#   jam 01:05        =>  reconcile-wallets
# (lihat panduan_vps.md untuk setup lengkap)

# ===== Build Configuration =====
BUILD_OUTPUT_DIR=./storage/builds
BUILD_TIMEOUT_MS=300000
BUILD_MAX_CONCURRENT=3

# ===== App Download URL =====
APP_DOWNLOAD_BASE_URL=http://localhost:3000/downloads

# =============================================
# CARA ISI KREDENSIAL YANG BELUM DIISI:
# =============================================
# 1. SUPABASE_URL & ANON_KEY:
#    → Sudah ada di assets/js/auth.js (frontend)
#    → Copy paste ke sini juga untuk backend
#
# 2. SUPABASE_SERVICE_ROLE_KEY & JWT_SECRET:
#    → Buka dashboard Supabase → Settings → API
#    → Copy "service_role" key (🔒 JANGAN EXPOSE)
#    → Copy "JWT Secret" (🔒 JANGAN EXPOSE)
#
# 3. PAKASIR_API_KEY & WEBHOOK_SECRET:
#    → https://app.pakasir.com (login → Project → API Key)
#
# 4. Setelah semua diisi, test:
#    node -e "require('dotenv').config(); console.log('✓ URL:', process.env.SUPABASE_URL); console.log('✓ KEY length:', process.env.SUPABASE_SERVICE_ROLE_KEY.length)"
# =============================================
